<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="64dp"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <ImageView
        android:id="@+id/item_navigation_drawer_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.seeds.seeds_calculator.Utils.TextViewPlus
        android:id="@+id/item_navigation_drawer_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="20dp"
        android:maxLines="1"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        app:customFont="syekan.otf"
        app:layout_constraintBottom_toBottomOf="@id/item_navigation_drawer_icon"
        app:layout_constraintRight_toLeftOf="@+id/item_navigation_drawer_icon"
        app:layout_constraintTop_toTopOf="@id/item_navigation_drawer_icon" />

</androidx.constraintlayout.widget.ConstraintLayout>