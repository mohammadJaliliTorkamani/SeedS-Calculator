<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <androidx.constraintlayout.widget.ConstraintLayout

        android:id="@+id/navigation_drawer_color_header_container"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:background="@android:color/holo_green_dark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <com.seeds.seeds_calculator.Utils.TextViewPlus
            android:id="@+id/navigation_drawer_color_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/casio_calculator"
            android:textColor="@android:color/white"
            android:textSize="20sp"
            android:textStyle="bold"
            app:customFont="syekan.otf"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/navigation_drawer_developer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="V: 1.1"
            android:textColor="@android:color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="@id/navigation_drawer_color_header"
            app:layout_constraintStart_toStartOf="@id/navigation_drawer_color_header"
            app:layout_constraintTop_toBottomOf="@id/navigation_drawer_color_header" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ir.tapsell.sdk.bannerads.TapsellBannerView
        android:id="@+id/navigation_drawer_banner"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_gravity="center_horizontal"
        android:layout_weight="4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:tapsell_banner_type="banner_300x250" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/navigation_drawer_rv"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginBottom="5dp"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/navigation_drawer_banner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/navigation_drawer_color_header_container" />

</androidx.constraintlayout.widget.ConstraintLayout>